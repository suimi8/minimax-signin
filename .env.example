# ── 必选其一：凭证存储（Serverless 无状态，必须外置）───────────────────
# 方式 A：Vercel KV（推荐）。在 Vercel 项目 → Storage → Create → KV，连接后会自动注入下面两个变量
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 方式 B：Vercel Blob
# BLOB_READ_WRITE_TOKEN=
# 方式 C：环境变量只读兜底（把 `npm run login` 输出的 JSON 整段粘进来）
# MINIMAX_CREDS={"cookie":{...},"token":"...","uuid":"...","deviceId":"...","userId":"..."}

# ── 安全 ────────────────────────────────────────────────────────────
# Cron 调用密钥。设置后 Vercel Cron 会自动带上 Authorization: Bearer <值>
CRON_SECRET=
# 网页管理口令。设置后访问 / 与 /api/status 需要输入
ADMIN_TOKEN=

# ── 可选：通知 ──────────────────────────────────────────────────────
# 通用 Webhook（POST JSON: {title, content, text}）
# NOTIFY_WEBHOOK=
# Bark（iOS）: https://api.day.app
# BARK_KEY=
# Server 酱 Turbo
# SERVERCHAN_KEY=
# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
